APP_NAME=NIKY PRAVITEL AI
HOST=127.0.0.1
PORT=8000
DATA_DIR=./storage
MAX_UPLOAD_MB=25
JOB_TIMEOUT_SECONDS=15

# Optional private GitHub repository bridge
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO=YOUR_PRIVATE_REPOSITORY
GITHUB_REF=main
GITHUB_TOKEN=

# If you deploy behind a real domain, set it here so API clients can copy the correct endpoint.
PUBLIC_API_BASE=http://127.0.0.1:8000
